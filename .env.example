# Darrel
# Copy this file to .env and fill in your own keys. Never commit .env.
GEMINI_API_KEY=your-gemini-api-key
GROQ_API_KEY=your-groq-api-key
# Optional. Where to keep incidents, photos, priorities and the site plan:
#   - a Postgres connection string (e.g. from Neon: Connect > connection string, pooling on), or
#   - a SQLite file path such as data/triage.db.
# Leave it empty (or delete the line) to save to local files in data/. If the database cannot be reached, the app
# says so and falls back to local files instead of crashing.
DATABASE_URL=
