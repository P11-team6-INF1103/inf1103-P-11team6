# Darrel
# Copy this file to .env and fill in your own keys. Never commit .env.
GEMINI_API_KEY=your-gemini-api-key
GROQ_API_KEY=your-groq-api-key
# Optional. Where to keep incidents, photos, priorities and the site plan:
#   - a Postgres connection string (e.g. from Neon: Connect > connection string, pooling on), or
#   - a SQLite file path such as data/triage.db.
# Leave it empty (or delete the line) to save to local files in data/. If the database cannot be reached, the app
# says so and falls back to local files instead of crashing.
DATABASE_URL=
# Optional. The supervisor accounts that can log in to the dashboard (there is no sign-up), as name:password pairs
# separated by commas. At start-up they are saved in the database as password hashes; no password lives in the code.
# Leave it empty on a fresh install and the server creates an account `supervisor` with a random password and writes it
# to the log once.
DASHBOARD_ACCOUNTS=
# Optional. Any long random text; it signs the login tokens. Leave it empty and every login ends when the server restarts.
AUTH_SECRET=
