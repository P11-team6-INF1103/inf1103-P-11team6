# Copy this file to .env and fill in your own keys. Never commit .env.
GEMINI_API_KEY=your-gemini-api-key
GROQ_API_KEY=your-groq-api-key
# Optional. Where the database layer keeps data:
#   - a Postgres connection string (e.g. from Neon: Connect > connection string, pooling on), or
#   - a SQLite file path such as data/triage.db.
# Leave it empty (or delete the line) to keep using the local files in data/.
DATABASE_URL=
